#:kivy 2.0
# improved responsive kv
# imports
# import dp helper
#:import dp kivy.metrics.dp

<GreenButton@Button>:
    background_color: 0, 0, 0, 0
    color: 1, 1, 1, 1
    font_size: dp(16)
    bold: True
    size_hint_y: None
    height: dp(48)
    padding: [dp(12), dp(8)]
    canvas.before:
        Color:
            rgba: 0.18, 0.7, 0.38, 1
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(16)]

<StyledLabel@Label>:
    color: 1, 1, 1, 1
    font_size: dp(20)
    bold: True

<ClickableLabel@Label>:
    color: 1,1,1,1
    markup: True
    font_size: dp(15)

# Home
<HomeScreen>:
    canvas.before:
        Rectangle:
            source: 'bg1.jpg'
            pos: self.pos
            size: self.size
        Color:
            rgba: 0,0,0,0.35
        Rectangle:
            pos: self.pos
            size: self.size
    BoxLayout:
        orientation: 'vertical'
        padding: dp(16)
        spacing: dp(14)
        Widget:
            size_hint_y: 0.25
        StyledLabel:
            text: 'WorkIt.'
            font_size: dp(40)
            halign: 'center'
            size_hint_y: None
            height: self.texture_size[1]
        BoxLayout:
            orientation: 'vertical'
            size_hint_y: None
            height: dp(180)
            spacing: dp(10)
            Button:
                text: 'My Workouts'
                on_release: app.root.current = 'my_workouts'
            Button:
                text: 'Progress'
                on_release: app.root.current = 'progress'
            Button:
                text: 'Tips'
                on_release: app.root.current = 'tips'

# My Workouts screen
<MyWorkoutsScreen>:
    on_pre_enter: root.on_pre_enter()
    BoxLayout:
        orientation: 'vertical'
        padding: dp(12)
        spacing: dp(10)
        BoxLayout:
            size_hint_y: None
            height: dp(56)
            Button:
                text: '< Back'
                size_hint_x: None
                width: dp(100)
                on_release: app.root.current = 'home'
            StyledLabel:
                text: 'My Workouts'
            Button:
                text: 'New'
                size_hint_x: None
                width: dp(100)
                on_release: app.root.current = 'workout_creation'
        ScrollView:
            GridLayout:
                id: workouts_box
                cols: 1
                size_hint_y: None
                height: self.minimum_height
                row_default_height: dp(48)
                spacing: dp(8)

# Workout creation
<WorkoutCreationScreen>:
    on_pre_enter: root.on_pre_enter()
    BoxLayout:
        orientation: 'vertical'
        padding: dp(12)
        spacing: dp(8)
        BoxLayout:
            size_hint_y: None
            height: dp(52)
            Button:
                text: '< Back'
                size_hint_x: None
                width: dp(100)
                on_release: app.root.current = 'my_workouts'
            StyledLabel:
                text: 'Create Workout'
        TextInput:
            id: workout_name
            hint_text: 'Workout name'
            size_hint_y: None
            height: dp(48)
            multiline: False
        TextInput:
            id: exercise_search
            hint_text: 'Search exercises'
            size_hint_y: None
            height: dp(44)
            multiline: False
        ScrollView:
            size_hint_y: 0.35
            GridLayout:
                id: exercise_search_results
                cols: 1
                size_hint_y: None
                height: self.minimum_height
                row_default_height: dp(36)
                spacing: dp(6)
        StyledLabel:
            text: 'Selected Exercises'
            size_hint_y: None
            height: dp(28)
        ScrollView:
            size_hint_y: 0.35
            GridLayout:
                id: exercise_list_box
                cols: 1
                size_hint_y: None
                height: self.minimum_height
                row_default_height: dp(32)
                spacing: dp(6)
        BoxLayout:
            size_hint_y: None
            height: dp(48)
            spacing: dp(8)
            Button:
                text: 'Save'
                on_release: root.save_workout()
            Button:
                text: 'Cancel'
                on_release: app.root.current = 'my_workouts'

# Premade popup
<PremadePopup@Popup>:
    title: 'Premade Workouts'
    size_hint: 0.95, 0.9
    BoxLayout:
        orientation: 'vertical'
        padding: dp(8)
        spacing: dp(8)
        ScrollView:
            GridLayout:
                id: premade_workout_box
                cols: 1
                size_hint_y: None
                height: self.minimum_height
                row_default_height: dp(120)
                spacing: dp(8)
        BoxLayout:
            size_hint_y: None
            height: dp(48)
            Button:
                text: 'Close'
                on_release: root.dismiss()

# Workout detail
<WorkoutDetailScreen>:
    on_pre_enter: root.on_pre_enter()
    BoxLayout:
        orientation: 'vertical'
        padding: dp(12)
        spacing: dp(8)
        BoxLayout:
            size_hint_y: None
            height: dp(56)
            Button:
                text: '< Back'
                size_hint_x: None
                width: dp(100)
                on_release: app.root.current = 'my_workouts'
            StyledLabel:
                id: workout_title
                text: ''
        ScrollView:
            GridLayout:
                id: workout_detail_box
                cols: 1
                size_hint_y: None
                height: self.minimum_height
                row_default_height: dp(56)
                spacing: dp(8)
        BoxLayout:
            size_hint_y: None
            height: dp(48)
            spacing: dp(8)
            Button:
                text: 'Finish'
                on_release: root.finish_workout()
            Button:
                text: 'Home'
                on_release: app.root.current = 'home'

# Progress
<ProgressScreen>:
    on_pre_enter: root.on_pre_enter()
    BoxLayout:
        orientation: 'vertical'
        padding: dp(12)
        spacing: dp(8)
        BoxLayout:
            size_hint_y: None
            height: dp(56)
            Button:
                text: '< Back'
                size_hint_x: None
                width: dp(100)
                on_release: app.root.current = 'home'
            StyledLabel:
                text: 'Progress'
        ScrollView:
            GridLayout:
                id: progress_box
                cols: 1
                size_hint_y: None
                height: self.minimum_height
                row_default_height: dp(44)
                spacing: dp(8)
        BoxLayout:
            size_hint_y: None
            height: dp(48)
            Button:
                text: 'Stats'
                on_release: root.go_to_stats()

# Stats
<StatsScreen>:
    on_pre_enter: root.on_pre_enter()
    BoxLayout:
        orientation: 'vertical'
        padding: dp(12)
        spacing: dp(8)
        BoxLayout:
            size_hint_y: None
            height: dp(56)
            Button:
                text: '< Back'
                size_hint_x: None
                width: dp(100)
                on_release: app.root.current = 'progress'
            StyledLabel:
                text: 'Stats'
        ScrollView:
            GridLayout:
                id: stats_box
                cols: 1
                size_hint_y: None
                height: self.minimum_height
                spacing: dp(8)

# Tips
<TipsScreen>:
    BoxLayout:
        orientation: 'vertical'
        padding: dp(8)
        spacing: dp(8)
        BoxLayout:
            size_hint_y: None
            height: dp(48)
            Button:
                text: '< Back'
                size_hint_x: None
                width: dp(100)
                on_release: app.root.current = 'home'
        ScrollView:
            Label:
                id: tips_label
                text: root.tips_text
                text_size: self.width, None
                size_hint_y: None
                height: self.texture_size[1]
                padding: [dp(16), dp(16), dp(16), dp(16)]
                BoxLayout:
                    size_hint_y: None
                    height: dp(54)
                    spacing: dp(10)
                    Widget:
                        size_hint_x: 0.3
                StyledLabel:
                    text: root.tips_text
                    halign: 'left'
                    valign: 'middle'
                    size_hint_y: None
                    text_size: self.width, None
                    height: self.texture_size[1] + dp(24)
