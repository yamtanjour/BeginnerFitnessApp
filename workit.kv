FloatLayout:
    Image:
        source: "fitness.png"
        allow_stretch: True
        keep_ratio: False
        size: self.parent.size
        pos: self.parent.pos

    BoxLayout:
        orientation: 'vertical'
        padding: [30, 40, 30, 40]
        spacing: 20
        size_hint: 1, 1
        pos_hint: {'center_x': 0.5, 'center_y': 0.5}

        Label:
            text: "GymBuddy"
            font_size: '48sp'
            color: 0.95, 0.95, 0.95, 1
            bold: True
            halign: 'center'
            valign: 'middle'
            text_size: self.size
            size_hint_y: 0.2

        Widget:
            size_hint_y: 0.1

        BoxLayout:
            orientation: 'vertical'
            spacing: 15
            size_hint_y: 0.4

            Button:
                text: "Start Workout"
                font_size: '22sp'
                background_normal: ''
                background_color: 0.2, 0.6, 0.3, 0.85
                color: 1, 1, 1, 1
                bold: True
                size_hint_y: None
                height: 55

            Button:
                text: "Progress Tracker"
                font_size: '22sp'
                background_normal: ''
                background_color: 0.15, 0.45, 0.7, 0.85
                color: 1, 1, 1, 1
                bold: True
                size_hint_y: None
                height: 55

            Button:
                text: "Settings"
                font_size: '22sp'
                background_normal: ''
                background_color: 0.3, 0.3, 0.3, 0.85
                color: 1, 1, 1, 1
                bold: True
                size_hint_y: None
                height: 55

        Widget:
            size_hint_y: 0.3