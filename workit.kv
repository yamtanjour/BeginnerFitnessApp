#:kivy 2.0

<RootWidget@ScreenManager>:
    canvas.before:
        Color:
            rgba: 0.1, 0.2, 0.5, 1  # blue background
        Rectangle:
            pos: self.pos
            size: self.size

<GreenButton@Button>:
    background_color: 0, 0, 0, 0
    color: 1, 1, 1, 1
    font_size: '16sp'
    bold: True
    canvas.before:
        Color:
            rgba: 0.2, 0.8, 0.4, 1  # green
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [20]

<ClickableLabel@Label>:
    color: 1, 1, 1, 1
    markup: True
    font_size: '16sp'

<StyledLabel@Label>:
    color: 1, 1, 1, 1
    font_size: '18sp'

<HomeScreen>:
    FloatLayout:
        GreenButton:
            text: "Go to My Workouts"
            size_hint: 0.6, 0.1
            pos_hint: {"center_x": 0.5, "center_y": 0.55}
            on_release: app.root.current = 'my_workouts'
        GreenButton:
            text: "Progress"
            size_hint: 0.4, 0.08
            pos_hint: {"center_x": 0.5, "y": 0.25}
            on_release: app.root.current = 'progress'
        GreenButton:
            text: "Tips"
            size_hint: 0.4, 0.08
            pos_hint: {"center_x": 0.5, "y": 0.13}
            on_release: app.root.current = 'tips'

<MyWorkoutsScreen>:
    on_pre_enter: root.on_pre_enter()
    BoxLayout:
        orientation: 'vertical'
        padding: 20
        spacing: 20
        BoxLayout:
            size_hint_y: None
            height: 50
            spacing: 10
            GreenButton:
                text: "< Back"
                size_hint_x: 0.3
                on_release: app.root.current = 'home'
            StyledLabel:
                text: "My Workouts"
            Widget:
                size_hint_x: 0.3
        ScrollView:
            BoxLayout:
                id: workouts_box
                orientation: 'vertical'
                size_hint_y: None
                height: self.minimum_height
        GreenButton:
            text: "+ Add Workout"
            size_hint_y: None
            height: 50
            on_release: app.root.current = 'workout_creation'

<WorkoutCreationScreen>:
    on_pre_enter: root.on_pre_enter()
    BoxLayout:
        orientation: 'vertical'
        padding: 20
        spacing: 10

        BoxLayout:
            size_hint_y: None
            height: 50
            spacing: 10
            GreenButton:
                text: "< Back"
                size_hint_x: 0.3
                on_release: app.root.current = 'my_workouts'
            StyledLabel:
                text: "Create Workout"
            Widget:
                size_hint_x: 0.3

        StyledLabel:
            text: "Workout Name:"
            size_hint_y: None
            height: 30

        TextInput:
            id: workout_name
            hint_text: "Enter workout name"
            size_hint_y: None
            height: 40
            multiline: False

        StyledLabel:
            text: "Search and Add Exercises:"
            size_hint_y: None
            height: 30

        BoxLayout:
            size_hint_y: None
            height: 40
            spacing: 10
            TextInput:
                id: exercise_search
                hint_text: "Type exercise name"
                multiline: False
                on_text: root.search_exercises()

        ScrollView:
            BoxLayout:
                id: exercise_search_results
                orientation: 'vertical'
                size_hint_y: None
                height: self.minimum_height

        GreenButton:
            text: "Premade Workouts"
            size_hint_y: None
            height: 40
            on_release: root.open_premade_popup()

        StyledLabel:
            text: "Exercises in Workout:"
            size_hint_y: None
            height: 30

        ScrollView:
            BoxLayout:
                id: exercise_list_box
                orientation: 'vertical'
                size_hint_y: None
                height: self.minimum_height

        Widget:
            size_hint_y: 1

        GreenButton:
            text: "Save Workout"
            size_hint_y: None
            height: 50
            on_release: root.save_workout()

<PremadePopup@Popup>:
    title: "Premade Workouts"
    size_hint: 0.95, 0.85
    BoxLayout:
        orientation: 'vertical'
        padding: 10
        spacing: 10
        ScrollView:
            BoxLayout:
                id: premade_workout_box
                orientation: 'vertical'
                size_hint_y: None
                height: self.minimum_height
        GreenButton:
            text: "Close"
            size_hint_y: None
            height: 40
            on_release: root.dismiss()

<WorkoutDetailScreen>:
    on_pre_enter: root.on_pre_enter()
    BoxLayout:
        orientation: 'vertical'
        padding: 20
        spacing: 20
        BoxLayout:
            size_hint_y: None
            height: 50
            spacing: 10
            GreenButton:
                text: "< Back"
                size_hint_x: 0.3
                on_release: app.root.current = 'my_workouts'
            StyledLabel:
                text: "Workout Progress"
            Widget:
                size_hint_x: 0.3
        ScrollView:
            BoxLayout:
                id: workout_detail_box
                orientation: 'vertical'
                size_hint_y: None
                height: self.minimum_height
        Widget:
            size_hint_y: 1
        GreenButton:
            text: "Finish Workout"
            size_hint_y: None
            height: 50
            on_release: root.finish_workout()

<ProgressScreen>:
    on_pre_enter: root.on_pre_enter()
    BoxLayout:
        orientation: 'vertical'
        padding: 20
        spacing: 10
        BoxLayout:
            size_hint_y: None
            height: 50
            spacing: 10
            GreenButton:
                text: "< Back"
                size_hint_x: 0.3
                on_release: app.root.current = 'home'
            StyledLabel:
                text: "Progress"
            Widget:
                size_hint_x: 0.3
        ScrollView:
            BoxLayout:
                id: progress_box
                orientation: 'vertical'
                size_hint_y: None
                height: self.minimum_height
        Widget:
            size_hint_y: 1
        GreenButton:
            text: "Stats"
            size_hint_y: None
            height: 50
            on_release: root.go_to_stats()

<StatsScreen>:
    on_pre_enter: root.on_pre_enter()
    BoxLayout:
        orientation: 'vertical'
        spacing: 10
        padding: 20
        BoxLayout:
            size_hint_y: None
            height: 50
            spacing: 10
            GreenButton:
                text: "< Back"
                size_hint_x: 0.3
                on_release: app.root.current = 'progress'
            StyledLabel:
                text: "Statistics"
            Widget:
                size_hint_x: 0.3
        ScrollView:
            BoxLayout:
                id: stats_box
                orientation: 'vertical'
                size_hint_y: None
                height: self.minimum_height
                size_hint_x: 1  # This makes it stretch!

<TipsScreen>:
    BoxLayout:
        orientation: 'vertical'
        padding: 20
        spacing: 20
        BoxLayout:
            size_hint_y: None
            height: 50
            spacing: 10
            GreenButton:
                text: "< Back"
                size_hint_x: 0.3
                on_release: app.root.current = 'home'
            StyledLabel:
                text: "Tips"
            Widget:
                size_hint_x: 0.3
        StyledLabel:
            text: "Here you can display workout tips or motivational content."
            halign: 'center'
            valign: 'middle'
