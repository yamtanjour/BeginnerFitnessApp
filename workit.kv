#:kivy 2.0

<HomeScreen>:
    FloatLayout:
        Button:
            text: "Go to My Workouts"
            size_hint: 0.6, 0.1
            pos_hint: {"center_x": 0.5, "center_y": 0.5}
            on_release:
                app.root.current = 'my_workouts'
        Button:
            text: "Tips"
            size_hint: 0.4, 0.08
            pos_hint: {"center_x": 0.5, "y": 0.1}
            on_release:
                app.root.current = 'tips'

<MyWorkoutsScreen>:
    on_pre_enter: root.on_pre_enter()
    BoxLayout:
        orientation: 'vertical'
        padding: 20
        spacing: 20

        BoxLayout:
            size_hint_y: None
            height: 50
            spacing: 10

            Button:
                text: "< Back"
                size_hint_x: 0.3
                on_release:
                    app.root.current = 'home'

            Label:
                text: "My Workouts"
                font_size: '24sp'
                color: 1,1,1,1
                halign: 'left'
                valign: 'middle'
                text_size: self.size

            Widget:
                size_hint_x: 0.3

        ScrollView:
            BoxLayout:
                id: workouts_box
                orientation: 'vertical'
                size_hint_y: None
                height: self.minimum_height

        Button:
            text: "+ Add Workout"
            size_hint_y: None
            height: 50
            on_release:
                app.root.current = 'workout_creation'

<WorkoutCreationScreen>:
    on_pre_enter: root.on_pre_enter()
    BoxLayout:
        orientation: 'vertical'
        padding: 20
        spacing: 20

        BoxLayout:
            size_hint_y: None
            height: 50
            spacing: 10

            Button:
                text: "< Back"
                size_hint_x: 0.3
                on_release:
                    app.root.current = 'my_workouts'

            Label:
                text: "Create Workout"
                font_size: '24sp'
                color: 1,1,1,1
                halign: 'left'
                valign: 'middle'
                text_size: self.size

            Widget:
                size_hint_x: 0.3

        Label:
            text: "Workout Name:"
            color: 1,1,1,1
            size_hint_y: None
            height: 30
            halign: 'left'
            valign: 'middle'
            text_size: self.size

        TextInput:
            id: workout_name
            hint_text: "Enter workout name"
            size_hint_y: None
            height: 40
            multiline: False

        Label:
            text: "Search and Add Exercises:"
            color: 1,1,1,1
            size_hint_y: None
            height: 30

        BoxLayout:
            size_hint_y: None
            height: 40
            spacing: 10

            TextInput:
                id: exercise_search
                hint_text: "Type exercise name"
                multiline: False
                on_text: root.search_exercises()

        ScrollView:
            BoxLayout:
                id: exercise_search_results
                orientation: 'vertical'
                size_hint_y: None
                height: self.minimum_height

        Label:
            text: "Exercises in Workout:"
            color: 0.8,0.8,0.8,1
            size_hint_y: None
            height: 30

        ScrollView:
            BoxLayout:
                id: exercise_list_box
                orientation: 'vertical'
                size_hint_y: None
                height: self.minimum_height

        Widget:
            size_hint_y: 1

        Button:
            text: "Save Workout"
            size_hint_y: None
            height: 50
            on_release: root.save_workout()

<WorkoutDetailScreen>:
    on_pre_enter: root.on_pre_enter()
    BoxLayout:
        orientation: 'vertical'
        padding: 20
        spacing: 20

        BoxLayout:
            size_hint_y: None
            height: 50
            spacing: 10

            Button:
                text: "< Back"
                size_hint_x: 0.3
                on_release:
                    app.root.current = 'my_workouts'

            Label:
                text: "Workout Progress"
                font_size: '24sp'
                color: 1,1,1,1
                halign: 'left'
                valign: 'middle'
                text_size: self.size

            Widget:
                size_hint_x: 0.3

        ScrollView:
            BoxLayout:
                id: workout_detail_box
                orientation: 'vertical'
                size_hint_y: None
                height: self.minimum_height

        Widget:
            size_hint_y: 1

        Button:
            text: "Finish Workout"
            size_hint_y: None
            height: 50
            on_release: root.finish_workout()

<TipsScreen>:
    BoxLayout:
        orientation: 'vertical'
        padding: 20
        spacing: 20

        BoxLayout:
            size_hint_y: None
            height: 50
            spacing: 10

            Button:
                text: "< Back"
                size_hint_x: 0.3
                on_release:
                    app.root.current = 'home'

            Label:
                text: "Tips"
                font_size: '24sp'
                color: 1,1,1,1
                halign: 'left'
                valign: 'middle'
                text_size: self.size
                
            Widget:
                size_hint_x: 0.3

        Label:
            text: "Here you can display workout tips or motivational content."
            color: 1,1,1,1
            halign: 'center'
            valign: 'middle'
            text_size: self.size