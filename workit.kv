#:kivy 2.0
#:import dp kivy.metrics.dp

<GreenButton@Button>:
    background_color: 0, 0, 0, 0
    color: 1, 1, 1, 1
    font_size: dp(18)
    bold: True
    size_hint_y: None
    height: dp(56)
    min_width: dp(200)
    padding: [dp(18), dp(12)]
    canvas.before:
        Color:
            rgba: 0.2, 0.8, 0.4, 1
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(28)]

<ClickableLabel@Label>:
    color: 1, 1, 1, 1
    markup: True
    font_size: dp(16)

<StyledLabel@Label>:
    color: 1, 1, 1, 1
    font_size: dp(22)
    bold: True

<RootWidget@ScreenManager>:
    canvas.before:
        Color:
            rgba: 0.1, 0.2, 0.5, 1
        Rectangle:
            pos: self.pos
            size: self.size

<HomeScreen>:
    canvas.before:
        Rectangle:
            source: "bg1.jpg"
            pos: self.pos
            size: self.size
        Color:
            rgba: 0, 0, 0, 0.4
        Rectangle:
            pos: self.pos
            size: self.size

<WorkoutCreationScreen>:
    canvas.before:
        Rectangle:
            source: "bg2.jpg"
            pos: self.pos
            size: self.size
        Color:
            rgba: 0, 0, 0, 0.4  
        Rectangle:
            pos: self.pos
            size: self.size

<StatsScreen>:
    canvas.before:
        Rectangle:
            source: "bg3.jpg"
            pos: self.pos
            size: self.size
        Color:
            rgba: 0, 0, 0, 0.4 
        Rectangle:
            pos: self.pos
            size: self.size

<ProgressScreen>:
    canvas.before:
        Rectangle:
            source: "bg4.jpg"
            pos: self.pos
            size: self.size
        Color:
            rgba: 0, 0, 0, 0.7  
        Rectangle:
            pos: self.pos
            size: self.size

<WorkoutDetailScreen>:
    canvas.before:
        Rectangle:
            source: "bg5.jpg"
            pos: self.pos
            size: self.size
        Color:
            rgba: 0, 0, 0, 0.7  
        Rectangle:
            pos: self.pos
            size: self.size

<MyWorkoutsScreen>:
    canvas.before:
        Rectangle:
            source: "bg5.jpg"
            pos: self.pos
            size: self.size
        Color:
            rgba: 0, 0, 0, 0.4 
        Rectangle:
            pos: self.pos
            size: self.size

<HomeScreen>:
    FloatLayout:
        StyledLabel:
            text: "WorkIt."
            font_size: dp(50)
            bold: True
            pos_hint: {"center_x": 0.5, "top": 0.8}
            size_hint: None, None
            size: self.texture_size
        GreenButton:
            text: "Go to My Workouts"
            size_hint: 0.8, None
            height: dp(60)
            pos_hint: {"center_x": 0.5, "center_y": 0.55}
            on_release: app.root.current = 'my_workouts'
        GreenButton:
            text: "Progress"
            size_hint: 0.7, None
            height: dp(54)
            pos_hint: {"center_x": 0.5, "y": 0.27}
            on_release: app.root.current = 'progress'
        GreenButton:
            text: "Tips"
            size_hint: 0.7, None
            height: dp(54)
            pos_hint: {"center_x": 0.5, "y": 0.13}
            on_release: app.root.current = 'tips'

<MyWorkoutsScreen>:
    on_pre_enter: root.on_pre_enter()
    BoxLayout:
        orientation: 'vertical'
        spacing: dp(14)
        padding: [dp(16), dp(14), dp(16), dp(14)]
        BoxLayout:
            size_hint_y: None
            height: dp(54)
            spacing: dp(10)
            GreenButton:
                text: "< Back"
                size_hint_x: 0.3
                on_release: app.root.current = 'home'
            StyledLabel:
                text: "My Workouts"
            Widget:
                size_hint_x: 0.3
        ScrollView:
            BoxLayout:
                id: workouts_box
                orientation: 'vertical'
                size_hint_y: None
                height: self.minimum_height
                spacing: dp(10)
        GreenButton:
            text: "+ Add Workout"
            size_hint_y: None
            height: dp(56)
            on_release: app.root.current = 'workout_creation'

<WorkoutCreationScreen>:
    on_pre_enter: root.on_pre_enter()
    BoxLayout:
        orientation: 'vertical'
        spacing: dp(12)
        padding: [dp(16), dp(12), dp(16), dp(12)]

        BoxLayout:
            size_hint_y: None
            height: dp(54)
            spacing: dp(10)
            GreenButton:
                text: "< Back"
                size_hint_x: 0.3
                on_release: app.root.current = 'my_workouts'
            StyledLabel:
                text: "Create Workout"
            Widget:
                size_hint_x: 0.3

        StyledLabel:
            text: "Workout Name:"
            size_hint_y: None
            height: dp(34)

        TextInput:
            id: workout_name
            hint_text: "Enter workout name"
            size_hint_y: None
            height: dp(44)
            multiline: False
            font_size: dp(18)
            padding: [dp(8), dp(10)]

        StyledLabel:
            text: "Search and Add Exercises:"
            size_hint_y: None
            height: dp(34)

        BoxLayout:
            size_hint_y: None
            height: dp(42)
            spacing: dp(10)
            TextInput:
                id: exercise_search
                hint_text: "Type exercise name"
                multiline: False
                on_text: root.search_exercises()
                font_size: dp(16)
                padding: [dp(8), dp(10)]

        ScrollView:
            size_hint_y: None
            height: dp(50)
            BoxLayout:
                id: exercise_search_results
                orientation: 'vertical'
                size_hint_y: None
                height: self.minimum_height
                spacing: dp(10)

        GreenButton:
            text: "Premade Workouts"
            size_hint_y: None
            height: dp(46)
            on_release: root.open_premade_popup()

        StyledLabel:
            text: "Exercises in Workout:"
            size_hint_y: None
            height: dp(34)

        Widget:
            size_hint_y: 1

        ScrollView:
            size_hint_y: None
            height: dp(180)
            BoxLayout:
                id: exercise_list_box
                orientation: 'vertical'
                size_hint_y: 1
                height: self.minimum_height
                spacing: dp(27)

        GreenButton:
            text: "Save Workout"
            size_hint_y: None
            height: dp(56)
            on_release: root.save_workout()

<PremadePopup@Popup>:
    title: "Premade Workouts"
    size_hint: 0.95, 0.9
    BoxLayout:
        orientation: 'vertical'
        padding: [dp(12), dp(12), dp(12), dp(12)]
        spacing: dp(10)
        ScrollView:
            BoxLayout:
                id: premade_workout_box
                orientation: 'vertical'
                size_hint_y: None
                height: self.minimum_height
                spacing: dp(10)
        GreenButton:
            text: "Close"
            size_hint_y: None
            height: dp(44)
            on_release: root.dismiss()

<WorkoutDetailScreen>:
    on_pre_enter: root.on_pre_enter()
    BoxLayout:
        orientation: 'vertical'
        spacing: dp(14)
        padding: [dp(16), dp(14), dp(16), dp(14)]
        BoxLayout:
            size_hint_y: None
            height: dp(54)
            spacing: dp(10)
            GreenButton:
                text: "< Back"
                size_hint_x: 0.3
                on_release: app.root.current = 'my_workouts'
            StyledLabel:
                text: "Workout Progress"
            Widget:
                size_hint_x: 0.3
        ScrollView:
            size_hint_y: None
            height: dp(420)
            BoxLayout:
                id: workout_detail_box
                orientation: 'vertical'
                size_hint_y: None
                height: self.minimum_height
                spacing: dp(9)
        Widget:
            size_hint_y: 1
        GreenButton:
            text: "Finish Workout"
            size_hint_y: None
            height: dp(56)
            on_release: root.finish_workout()

<ProgressScreen>:
    on_pre_enter: root.on_pre_enter()
    BoxLayout:
        orientation: 'vertical'
        spacing: dp(12)
        padding: [dp(16), dp(12), dp(16), dp(12)]
        BoxLayout:
            size_hint_y: None
            height: dp(54)
            spacing: dp(10)
            GreenButton:
                text: "< Back"
                size_hint_x: 0.3
                on_release: app.root.current = 'home'
            StyledLabel:
                text: "Progress"
            Widget:
                size_hint_x: 0.3
        ScrollView:
            BoxLayout:
                id: progress_box
                orientation: 'vertical'
                size_hint_y: None
                height: self.minimum_height
                spacing: dp(8)
        Widget:
            size_hint_y: 1
        GreenButton:
            text: "Stats"
            size_hint_y: None
            height: dp(54)
            on_release: root.go_to_stats()

<StatsScreen>:
    on_pre_enter: root.on_pre_enter()
    BoxLayout:
        orientation: 'vertical'
        spacing: dp(12)
        padding: [dp(16), dp(12), dp(16), dp(12)]
        BoxLayout:
            size_hint_y: None
            height: dp(54)
            spacing: dp(10)
            GreenButton:
                text: "< Back"
                size_hint_x: 0.3
                on_release: app.root.current = 'progress'
            StyledLabel:
                text: "Statistics"
            Widget:
                size_hint_x: 0.3
        ScrollView:
            BoxLayout:
                id: stats_box
                orientation: 'vertical'
                size_hint_y: None
                height: self.minimum_height
                size_hint_x: 1
                spacing: dp(9)

<TipsScreen>:
    BoxLayout:
        orientation: 'vertical'
        spacing: dp(18)
        padding: [dp(16), dp(16), dp(16), dp(16)]
        BoxLayout:
            size_hint_y: None
            height: dp(54)
            spacing: dp(10)
            GreenButton:
                text: "< Back"
                size_hint_x: 0.3
                on_release: app.root.current = 'home'
            StyledLabel:
                text: "Tips"
            Widget:
                size_hint_x: 0.3
        StyledLabel:
            text: "Here you can display workout tips or motivational content."
            halign: 'center'
            valign: 'middle'
