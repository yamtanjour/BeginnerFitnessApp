#:kivy 2.0

<HomeScreen>:
    FloatLayout:
        Button:
            text: "Go to My Workouts"
            size_hint: 0.6, 0.1
            pos_hint: {"center_x": 0.5, "center_y": 0.5}
            on_release:
                app.root.current = 'my_workouts'

<MyWorkoutsScreen>:
    BoxLayout:
        orientation: 'vertical'
        padding: 20
        spacing: 20

        BoxLayout:
            size_hint_y: None
            height: 50
            spacing: 10

            Button:
                text: "< Back"
                size_hint_x: 0.3
                on_release:
                    app.root.current = 'home'

            Label:
                text: "My Workouts"
                font_size: '24sp'
                color: 1,1,1,1
                halign: 'left'
                valign: 'middle'
                text_size: self.size

            Widget:
                size_hint_x: 0.3

        ScrollView:
            BoxLayout:
                id: workouts_box
                orientation: 'vertical'
                size_hint_y: None
                height: self.minimum_height

        Button:
            text: "+ Add Workout"
            size_hint_y: None
            height: 50
            on_release:
                # You can add logic to open a popup or another screen to add a workout
                print("Add Workout pressed")