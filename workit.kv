#:kivy 2.0
# improved responsive kv
# imports
# import dp helper
#:import dp kivy.metrics.dp

<RobotoButton@Button>:
    font_name: 'Roboto'

<RobotoLabel@Label>:
    font_name: 'Roboto'

<GreenButton@Button>:
    background_color: 0, 0, 0, 0
    color: 1, 1, 1, 1
    font_name: 'Roboto'
    font_size: dp(16)
    bold: True
    size_hint_y: None
    height: dp(48)
    padding: [dp(12), dp(8)]
    canvas.before:
        Color:
            rgba: 0.165, 0.388, 0.58, 1
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(16)]

<StyledLabel@Label>:
    color: 1, 1, 1, 1
    font_name: 'Roboto'
    font_size: dp(20)
    bold: True

<ClickableLabel@Label>:
    color: 1,1,1,1
    markup: True
    font_name: 'Roboto'
    font_size: dp(15)

# Home
<HomeScreen>:
    canvas.before:
        Rectangle:
            source: 'bg1.jpg'
            pos: self.pos
            size: self.size
        Color:
            rgba: 0,0,0,0.35
        Rectangle:
            pos: self.pos
            size: self.size
    BoxLayout:
        orientation: 'vertical'
        padding: dp(16)
        spacing: dp(14)
        Widget:
            size_hint_y: 0.25
        StyledLabel:
            text: 'WorkIt.'
            font_size: dp(40)
            halign: 'center'
            size_hint_y: None
            height: self.texture_size[1]
        BoxLayout:
            orientation: 'vertical'
            size_hint_y: None
            height: dp(180)
            spacing: dp(10)
            RobotoButton:
                text: 'My Workouts'
                on_release: app.root.current = 'my_workouts'
            RobotoButton:
                text: 'Premade'
                on_release: app.root.current = 'premade'
            RobotoButton:
                text: 'Progress'
                on_release: app.root.current = 'progress'
        BoxLayout:
            orientation: 'vertical'
            size_hint_y: None
            height: dp(120)
            padding: dp(10)
            canvas.before:
                Color:
                    rgba: 0.16, 0.39, 0.58, 0.8   # blue background
                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [dp(12)]
            ScrollView:
                do_scroll_x: False
                do_scroll_y: True
            StyledLabel:
                id: daily_tip
                text: root.daily_tip
                halign: 'center'                    
                valign: 'middle'
                text_size: self.width, None


# My Workouts screen
<MyWorkoutsScreen>:
    canvas.before:
        Rectangle:
            source: 'bg2.jpg'
            pos: self.pos
            size: self.size
        Color:
            rgba: 0,0,0,0.35
        Rectangle:
            pos: self.pos
            size: self.size
    on_pre_enter: root.on_pre_enter()
    BoxLayout:
        orientation: 'vertical'
        padding: dp(12)
        spacing: dp(10)
        BoxLayout:
            size_hint_y: None
            height: dp(56)
            RobotoButton:
                text: '< Back'
                size_hint_x: None
                width: dp(100)
                on_release: app.root.current = 'home'
            StyledLabel:
                text: 'My Workouts'
            RobotoButton:
                text: 'Premade'
                size_hint_x: None
                width: dp(100)
                on_release: app.root.current = 'premade'
            RobotoButton:
                text: 'New'
                size_hint_x: None
                width: dp(100)
                on_release: app.root.current = 'workout_creation'
        ScrollView:
            GridLayout:
                id: workouts_box
                cols: 1
                size_hint_y: None
                height: self.minimum_height
                row_default_height: dp(48)
                spacing: dp(8)

# Workout creation
<WorkoutCreationScreen>:
    canvas.before:
        Rectangle:
            source: 'bg3.jpg'
            pos: self.pos
            size: self.size
        Color:
            rgba: 0,0,0,0.35
        Rectangle:
            pos: self.pos
            size: self.size
    on_pre_enter: root.on_pre_enter()
    BoxLayout:
        orientation: 'vertical'
        padding: dp(12)
        spacing: dp(8)
        BoxLayout:
            size_hint_y: None
            height: dp(52)
            RobotoButton:
                text: '< Back'
                size_hint_x: None
                width: dp(100)
                on_release: app.root.current = 'my_workouts'
            StyledLabel:
                text: 'Create Workout'
        TextInput:
            id: workout_name
            hint_text: 'Workout name'
            size_hint_y: None
            height: dp(48)
            multiline: False
        BoxLayout:
            orientation: 'vertical'
            size_hint_y: None
            height: dp(200)  # Adjust this if you want more space for search/results

            TextInput:
                id: exercise_search
                hint_text: 'Type exercise name'
                size_hint_y: None
                height: dp(44)
                multiline: False
                on_text: root.update_search_results(self.text)
                on_text_validate: root.add_exercise_from_input(self.text); self.text = ''

            RobotoButton:
                text: 'Premade Workout'
                size_hint_y: None
                height: dp(48)
                on_release: root.show_premade_popup()  # or whatever function you have

            ScrollView:
                size_hint_y: 1  # This lets it expand dynamically
                GridLayout:
                    id: exercise_search_results
                    cols: 1
                    size_hint_y: None
                    height: self.minimum_height
                    row_default_height: dp(36)
                    spacing: dp(6)
        StyledLabel:
            text: 'Selected Exercises'
            size_hint_y: None
            height: dp(28)
        ScrollView:
            size_hint_y: 0.35
            GridLayout:
                id: exercise_list_box
                cols: 1
                size_hint_y: None
                height: self.minimum_height
                row_default_height: dp(32)
                spacing: dp(6)
        BoxLayout:
            size_hint_y: None
            height: dp(48)
            spacing: dp(8)
            RobotoButton:
                text: 'Save'
                on_release: root.save_workout()
            RobotoButton:
                text: 'Cancel'
                on_release: app.root.current = 'my_workouts'

# Premade popup
<PremadePopup@Popup>:
    title: 'Premade Workouts'
    size_hint: 0.95, 0.9
    BoxLayout:
        orientation: 'vertical'
        padding: dp(8)
        spacing: dp(8)
        ScrollView:
            GridLayout:
                id: premade_workout_box
                cols: 1
                size_hint_y: None
                height: self.minimum_height
                row_default_height: dp(120)
                spacing: dp(8)
        BoxLayout:
            size_hint_y: None
            height: dp(48)
            Button:
                text: 'Close'
                on_release: root.dismiss()

# Full screen premade browser
<PremadeScreen>:
    canvas.before:
        Rectangle:
            source: 'bg3.jpg'
            pos: self.pos
            size: self.size
        Color:
            rgba: 0,0,0,0.35
        Rectangle:
            pos: self.pos
            size: self.size
    BoxLayout:
        orientation: 'vertical'
        padding: dp(12)
        spacing: dp(8)
        BoxLayout:
            size_hint_y: None
            height: dp(56)
            RobotoButton:
                text: '< Back'
                size_hint_x: None
                width: dp(100)
                on_release: app.root.current = 'home'
            StyledLabel:
                text: 'Premade Workouts'
            RobotoButton:
                text: 'Refresh'
                size_hint_x: None
                width: dp(100)
                on_release: root.on_pre_enter()
        ScrollView:
            GridLayout:
                id: premade_list
                cols: 1
                size_hint_y: None
                height: self.minimum_height
                row_default_height: dp(100)
                spacing: dp(8)

# Workout detail
<WorkoutDetailScreen>:
    canvas.before:
        Rectangle:
            source: 'bg4.jpg'
            pos: self.pos
            size: self.size
        Color:
            rgba: 0,0,0,0.35
        Rectangle:
            pos: self.pos
            size: self.size
    on_pre_enter: root.on_pre_enter()
    BoxLayout:
        orientation: 'vertical'
        padding: dp(12)
        spacing: dp(8)
        BoxLayout:
            size_hint_y: None
            height: dp(56)
            Button:
                text: '< Back'
                size_hint_x: None
                width: dp(100)
                on_release: app.root.current = 'my_workouts'
            StyledLabel:
                id: workout_title
                text: ''
        ScrollView:
            GridLayout:
                id: workout_detail_box
                cols: 1
                size_hint_y: None
                height: self.minimum_height
                row_default_height: dp(56)
                spacing: dp(8)
        BoxLayout:
            size_hint_y: None
            height: dp(48)
            spacing: dp(8)
            RobotoButton:
                text: 'Finish'
                on_release: root.finish_workout()
            RobotoButton:
                text: 'Home'
                on_release: app.root.current = 'home'

# Progress
<ProgressScreen>:
    canvas.before:
        Rectangle:
            source: 'bg5.jpg'
            pos: self.pos
            size: self.size
        Color:
            rgba: 0,0,0,0.35
        Rectangle:
            pos: self.pos
            size: self.size
    on_pre_enter: root.on_pre_enter()
    BoxLayout:
        orientation: 'vertical'
        padding: dp(12)
        spacing: dp(8)
        BoxLayout:
            size_hint_y: None
            height: dp(56)
            RobotoButton:
                text: '< Back'
                size_hint_x: None
                width: dp(100)
                on_release: app.root.current = 'home'
            StyledLabel:
                text: 'Progress'
        ScrollView:
            GridLayout:
                id: progress_box
                cols: 1
                size_hint_y: None
                height: self.minimum_height
                row_default_height: dp(44)
                spacing: dp(8)
        BoxLayout:
            size_hint_y: None
            height: dp(48)
            Button:
                text: 'Stats'
                on_release: root.go_to_stats()

# Stats
<StatsScreen>:
    canvas.before:
        Rectangle:
            source: 'bg6.jpg'
            pos: self.pos
            size: self.size
        Color:
            rgba: 0,0,0,0.35
        Rectangle:
            pos: self.pos
            size: self.size
    on_pre_enter: root.on_pre_enter()
    BoxLayout:
        orientation: 'vertical'
        padding: dp(12)
        spacing: dp(8)
        BoxLayout:
            size_hint_y: None
            height: dp(56)
            RobotoButton:
                text: '< Back'
                size_hint_x: None
                width: dp(100)
                on_release: app.root.current = 'progress'
            StyledLabel:
                text: 'Stats'
        ScrollView:
            GridLayout:
                id: stats_box
                cols: 1
                size_hint_y: None
                height: self.minimum_height
                spacing: dp(8)
